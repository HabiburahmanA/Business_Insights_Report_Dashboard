# Copy this file to .env.local for local development with `vercel dev`.
# In production, set this in your hosting provider's dashboard instead
# (Vercel: Project Settings -> Environment Variables).
# Never commit your real .env or .env.local file — it's already in .gitignore.

# Required for the "Generate AI Insights" feature. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5
